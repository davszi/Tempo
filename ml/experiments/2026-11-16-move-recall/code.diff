new file mode 100644
index 0000000..c8134b9
--- /dev/null
+++ b/ml/tempo_ml/pass_chance.py
@@ -0,0 +1,74 @@
+"""Mistake limits and the pass chance of a line from per-move recall.
+
+Owners: docs/topics/session-grading/session-grading.md (mistake limits,
+section 3.2) and docs/topics/move-recall/move-recall.md (pass chance and the
+per-move scheduling target, sections 2 and 3.3).
+
+A review passes when it has at most ``L(M)`` mistakes. When each of the M
+player moves is right independently with per-move recall R, the pass chance is
+
+    p_pass(R, M) = sum_{k=0..L(M)} C(M, k) (1 - R)^k R^(M - k).
+
+``per_move_target(M)`` is the R at which ``p_pass(R, M)`` equals the target
+(0.9): a line is due when its per-move recall falls to it.
+
+``p_pass`` works on numpy arrays and torch tensors alike (only arithmetic).
+"""
+
+from __future__ import annotations
+
+from math import comb
+
+import numpy as np
+
+TARGET_PASS = 0.9
+MAX_LIMIT = 3  # largest mistake limit (13 or more moves)
+
+
+def mistake_limit(num_moves):
+    """L(M): 0 for M <= 3, 1 for 4-7, 2 for 8-12, 3 for 13 or more (scalar or array)."""
+    m = np.asarray(num_moves)
+    out = np.where(m <= 3, 0, np.where(m <= 7, 1, np.where(m <= 12, 2, 3)))
+    return int(out) if out.ndim == 0 else out
+
+
+def binomial_terms(num_moves) -> np.ndarray:
+    """(..., MAX_LIMIT + 1) coefficients C(M, k) for k <= L(M), else 0."""
+    m = np.asarray(num_moves, dtype=int)
+    lim = np.asarray(mistake_limit(m))
+    coef = np.zeros(m.shape + (MAX_LIMIT + 1,))
+    for k in range(MAX_LIMIT + 1):
+        c = np.vectorize(lambda x, k=k: comb(int(x), k), otypes=[float])(m) if m.ndim else comb(int(m), k)
+        coef[..., k] = np.where(k <= lim, c, 0.0)
+    return coef
+
+
+def p_pass(R, num_moves, coef=None):
+    """Chance of at most L(M) mistakes with per-move recall R.
+
+    ``R`` and ``num_moves`` broadcast together. ``coef`` (from
+    ``binomial_terms``, shaped like the broadcast plus a last axis of 4) may be
+    passed to avoid recomputing it; it must be a torch tensor when ``R`` is.
+    """
+    if coef is None:
+        coef = binomial_terms(num_moves)
+    m = num_moves
+    total = 0.0
+    for k in range(MAX_LIMIT + 1):
+        total = total + coef[..., k] * (1.0 - R) ** k * R ** (m - k)
+    return total
+
+
+def per_move_target(num_moves: int, target: float = TARGET_PASS) -> float:
+    """R*(M): the per-move recall at which the pass chance equals ``target``."""
+    m = int(num_moves)
+    if m < 1:
+        raise ValueError(f"num_moves must be >= 1, got {m}")
+    lo, hi = 0.0, 1.0  # p_pass increases with R: bisection to machine precision
+    for _ in range(200):
+        mid = 0.5 * (lo + hi)
+        if p_pass(mid, m) < target:
+            lo = mid
+        else:
+            hi = mid
+    return 0.5 * (lo + hi)
diff --git a/ml/tempo_ml/simulator/memory/state.py b/ml/tempo_ml/simulator/memory/state.py
new file mode 100644
index 0000000..e58c8c5
--- /dev/null
+++ b/ml/tempo_ml/simulator/memory/state.py
@@ -0,0 +1,66 @@
+"""Hidden memory state of one line for one synthetic client.
+
+Specified (synthetic-clients record, sections 3.2 and 3.5):
+- per-move retrievability R(t, S) = (1 + F * t / S) ** (-C), F = 0.9^(-1/C) - 1
+- reps update: +1 after a passed review, max(0, reps - 2) after a lapse (Again)
+
+Stability and difficulty evolve through the FSRS-6 memory (``memory/fsrs.py``).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+BLUNDER_REPS_PENALTY = 2
+
+
+def retrievability(t_days: float, stability: float, C: float) -> float:
+    """Power-law forgetting curve R(t, S) with F = 0.9^(-1/C) - 1."""
+    if t_days < 0.0:
+        raise ValueError(f"t_days must be >= 0, got {t_days}")
+    if stability <= 0.0:
+        raise ValueError(f"stability must be > 0, got {stability}")
+    F = 0.9 ** (-1.0 / C) - 1.0
+    return float((1.0 + F * t_days / stability) ** (-C))
+
+
+def next_reps(reps: int, lapsed: bool) -> int:
+    """Practice accumulation with the soft 2-step lapse penalty."""
+    if lapsed:
+        return max(0, reps - BLUNDER_REPS_PENALTY)
+    return reps + 1
+
+
+@dataclass
+class LineMemory:
+    """Ground-truth memory of one line, hidden from the planner.
+
+    Attributes:
+        stability: Current S in days (None until the line is first seen).
+        difficulty: Current FSRS-6 difficulty D (None until the line is first seen).
+        reps: Accumulated practice count driving m_practice.
+        last_session_day: Simulation day of the last session on this line.
+        last_review_lapsed: Whether the last Repeating Mode session was graded Again.
+        sessions: Number of sessions so far (both modes).
+    """
+
+    stability: float | None = None
+    difficulty: float | None = None
+    reps: int = 0
+    last_session_day: float | None = None
+    last_review_lapsed: bool = False
+    sessions: int = 0
+
+    @property
+    def seen(self) -> bool:
+        return self.stability is not None
+
+    def elapsed(self, now_day: float) -> float:
+        if self.last_session_day is None:
+            return 0.0
+        t = now_day - self.last_session_day
+        if t < 0.0:
+            raise ValueError(
+                f"session day {now_day} is before the last session day {self.last_session_day}"
+            )
+        return t
