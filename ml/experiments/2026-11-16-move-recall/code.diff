+        return bce(np.clip(p, 1e-6, 1 - 1e-6), c.y[mask]).mean()
+    y = c.acc[mask] if arm == "accuracy" else target[mask]
+    return (mg * bce(np.clip(r, 1e-6, 1 - 1e-6), y)).sum() / mg.sum()
